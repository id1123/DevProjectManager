{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Hub",
  "version": "0.6.4",
  "identifier": "com.devprojectmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "本地项目管理器",
        "width": 1360,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 640
      },
      {
        "label": "launcher",
        "title": "快速启动",
        "url": "index.html?window=launcher",
        "width": 720,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NDQyN0VERUFENEU3RTYKUldUbTU5VHE3U2RFS1AwS3l6cnF1WGltS1hyallBTVhjR0RTMW5yVTZ6L2pQYnVRSEhLdVZ2c0UK",
      "endpoints": [
        "https://github.com/id1123/DevProjectManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
