{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Hub",
  "version": "0.5.0-alpha",
  "identifier": "com.devprojectmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "本地项目管理器",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "launcher",
        "title": "快速启动",
        "url": "index.html?window=launcher",
        "width": 720,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
